@using Microsoft.AspNetCore.Components.Authorization
@using System.IdentityModel.Tokens.Jwt
@inject HttpClient Http

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CBT.Web</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Dashboard">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        @* Menambahkan logika untuk mengambil role berdasarkan userId *@
        @if (userManagements != null)
        {
            var user = userManagements.FirstOrDefault(u => u.id == userId);
            var userRole = user?.role;

            if (userRole == "educator")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="QuestionTopicList">
                        <span class="bi bi-gear-wide-connected-nav-menu" aria-hidden="true"></span> Examination Setup
                    </NavLink>
                </div>
            }
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ProfileForm">
                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Profile
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-arrow-left-square-fill-nav-menu" aria-hidden="true"></span> Logout
            </NavLink>
        </div>
