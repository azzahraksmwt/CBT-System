@page "/QuestionTopicList"

@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Topic</PageTitle>

<NavbarExamSetup/>

<div class="card mt-4">
    <div class="card-body">
        <div class="justify-content-between d-flex flex-row">
            <TitleView text="Question Topic List"/>
            <NavLink class="nav-link card bg-light border-0 shadow-sm text-primary justify-content-center" href="QuestionTopicForm">
                <span class="d-flex flex-row">
                    <i class="bi bi-plus-circle-fill me-2"></i> Add
                </span>
            </NavLink>
        </div>

        @if (topics == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <table class="table border mt-3">
                <thead>
                    <tr>
                        <th class="text-center">Topic Name</th>
                        <th class="text-center">Difficulty Level</th>
                        <th class="text-center">Duration (In Minutes)</th>
                        <th class="text-center">Total Questions</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var topic in topics)
                    {
                        <tr>
                            <td>@topic.topic_name</td>
                            <td class="text-center">@topic.difficulty_level</td>
                            <td class="text-center">@topic.duration</td>
                            <td class="text-center">@topic.total_questions</td>
                            <td class="text-center">
                                <span class="d-flex flex-row justify-content-center">
                                    <NavLink class="nav-link card bg-light border-0 shadow-sm text-primary" href="@($"QuestionTopicForm/{topic.id}")">
                                        <i class="bi bi-pencil-fill"></i>
                                    </NavLink>
                                    <NavLink class="nav-link card ms-2 bg-light border-0 shadow-sm text-danger" @onclick="() => ConfirmDelete(topic.id)">
                                        <i class="bi bi-trash-fill"></i>
                                    </NavLink>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private TopicVM[]? topics;

    protected override async Task OnInitializedAsync()
    {
        topics = await Http.GetFromJsonAsync<TopicVM[]>("http://localhost:5234/api/QuestionTopic");
    }

    private async Task ConfirmDelete(int? topicId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this topic?");

        if (confirmed)
        {
            await DeleteTopic(topicId);
        }
    }

    private async Task DeleteTopic(int? topicId)
    {
        if (topicId.HasValue)
        {
            var response = await Http.DeleteAsync($"http://localhost:5234/api/QuestionTopic/{topicId}");
            if (response.IsSuccessStatusCode)
            {
                topics = topics.Where(t => t.id != topicId).ToArray();
            }
        }
    }

    public class TopicVM
    {
        public int? id { get; set;  }
        public string? topic_name { get; set; }
        public string? difficulty_level { get; set; }
        public string? duration { get; set; }
        public string? total_questions { get; set; }
    }
}
