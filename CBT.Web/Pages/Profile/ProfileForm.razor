@page "/ProfileForm"
@using Microsoft.AspNetCore.Components.Authorization
@using System.IdentityModel.Tokens.Jwt

<div class="card mt-4">
    <div class="card-body">
        <TitleView text="Profile Form" />

        <div class="card mt-3">
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input id="name" type="text" class="form-control" @bind="UserProfile.name" disabled="@(IsEditing ? false : true)" />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input id="email" type="email" class="form-control" @bind="UserProfile.email" disabled="@(IsEditing ? false : true)" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input id="password" type="password" class="form-control" @bind="UserProfile.password" disabled="@(IsEditing ? false : true)" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label for="role" class="form-label">Role</label>
                        <input id="role" type="text" class="form-control" @bind="UserProfile.role" disabled />
                    </div>
                </form>
                <div class="d-flex justify-content-end">
                    @if (IsEditing)
                    {
                        <button class="btn btn-success me-2" @onclick="SaveChanges">Save</button>
                        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="EnableEdit">Edit</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserManagement UserProfile { get; set; } = new UserManagement();
    private bool IsEditing { get; set; } = false;

    [Inject] private HttpClient HttpClient { get; set; }
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfileAsync();
    }

    private async Task LoadUserProfileAsync()
    {
        try
        {
            int userId = await GetUserIdFromClaims();
            if (userId != 0)
            {
                var response = await HttpClient.GetFromJsonAsync<UserManagement>($"http://localhost:5234/api/UserManagement/{userId}");
                if (response != null)
                {
                    UserProfile = response;
                }
                else
                {
                    Console.WriteLine("Failed to load profile: No data found.");
                }
            }
            else
            {
                Console.WriteLine("User ID claim is not available.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user profile: {ex.Message}");
        }
    }

    private async Task<int> GetUserIdFromClaims()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userIdClaim = user?.Claims.FirstOrDefault(c => c.Type == JwtRegisteredClaimNames.Sub)?.Value;
        return userIdClaim != null ? int.Parse(userIdClaim) : 0;
    }

    private async Task SaveChanges()
    {
        try
        {
            // Dapatkan userId dari klaim
            int userId = await GetUserIdFromClaims();
            if (userId != 0)
            {
                UserProfile.id = userId; // Pastikan id yang digunakan sesuai dengan klaim

                var response = await HttpClient.PutAsJsonAsync($"http://localhost:5234/api/UserManagement/{userId}", UserProfile);
                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("User profile updated successfully.");
                }
                else
                {
                    Console.WriteLine($"Failed to update user: {response.StatusCode}");
                }
            }
            else
            {
                Console.WriteLine("User ID is not available, cannot save changes.");
            }
            IsEditing = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving changes: {ex.Message}");
        }
    }

    private void EnableEdit()
    {
        IsEditing = true;
    }

    private void CancelEdit()
    {
        IsEditing = false;
        // Reload the user profile to reset the form fields
        LoadUserProfileAsync();
    }

    public class UserManagement
    {
        public int id { get; set; }
        public string name { get; set; } = string.Empty;
        public string email { get; set; } = string.Empty;
        public string password { get; set; } = string.Empty;
        public string role { get; set; } = string.Empty;
    }
}
